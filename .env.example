# Mini Lakehouse — environment variables TEMPLATE
# Copy -> .env  |  fill strong secrets  |  never commit .env (it is gitignored)
# Generate secrets:  openssl rand -hex 18

# --- Versions (pin centrally; rebuild after change) ---
SPARK_VERSION=4.0.1
SCALA_VERSION=2.13
ICEBERG_VERSION=1.10.0
ICEBERG_SPARK_RUNTIME_VERSION=4.0
AWS_SDK_VERSION=2.20.18
TRINO_VERSION=465

# --- Storage: MinIO (was admin/password — MUST change) ---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_32char

# --- Catalog: Polaris (was root/s3cr3t — MUST change) ---
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=CHANGE_ME_strong_32char

# --- Jupyter (was NO password — MUST set) ---
JUPYTER_TOKEN=CHANGE_ME_strong_32char

# --- Trino (used only if you enable app-level password auth; else ignored) ---
TRINO_ADMIN_USER=admin
TRINO_ADMIN_PASSWORD=CHANGE_ME_strong_32char
